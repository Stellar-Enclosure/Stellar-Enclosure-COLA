<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>top.egon.internal.archetype.source</groupId>
        <artifactId>stellar-enclosure-source-web</artifactId>
        <version>${stellar-enclosure.version}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>stellar-enclosure-source-web-starter</artifactId>
    <packaging>jar</packaging>
    <name>stellar-enclosure-source-web-starter</name>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>top.egon</groupId>
                <artifactId>stellar-enclosure-tianquan-jianshen-starter</artifactId>
                <version>${stellar-enclosure.tianquan-jianshen.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-tianquan-jianshen-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon.internal.archetype.source</groupId>
            <artifactId>stellar-enclosure-source-web-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon.internal.archetype.source</groupId>
            <artifactId>stellar-enclosure-source-web-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-component-rpc-tianshu-adapter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-tianshu-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-tianshu-http-registration-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>top.egon</groupId>
            <artifactId>stellar-enclosure-yuheng-starter-openapi-webmvc</artifactId>
        </dependency>
    </dependencies>

    <properties>
        <stellar-enclosure.tianquan-jianshen.version>0.0.1</stellar-enclosure.tianquan-jianshen.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-launch-args</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <overwrite>true</overwrite>
                            <delimiters>
                                <delimiter>@</delimiter>
                            </delimiters>
                            <useDefaultDelimiters>false</useDefaultDelimiters>
                            <resources>
                                <resource>
                                    <directory>src/main/launch</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>launch.args</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>${run.jvm-args}</jvmArguments>
                    <profiles>
                        <profile>${run.profile}</profile>
                    </profiles>
                    <systemPropertyVariables>
                        <server.port>${run.server-port}</server.port>
                        <spring.config.additional-location>${run.config-location}</spring.config.additional-location>
                    </systemPropertyVariables>
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.maven.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>top.egon</groupId>
                <artifactId>stellar-enclosure-component-bytecode-architecture-maven-plugin</artifactId>
                <version>${stellar-enclosure.version}</version>
                <configuration>
                    <unknownLayerPolicy>FAIL</unknownLayerPolicy>
                    <packageMappings>
                        <top.egon.cola.archetype.source.web.common..>COMMON</top.egon.cola.archetype.source.web.common..>
                        <top.egon.cola.archetype.source.web.facade..>FACADE</top.egon.cola.archetype.source.web.facade..>
                        <top.egon.cola.archetype.source.web.domain..>DOMAIN</top.egon.cola.archetype.source.web.domain..>
                        <top.egon.cola.archetype.source.web.application..>APPLICATION</top.egon.cola.archetype.source.web.application..>
                        <top.egon.cola.archetype.source.web.infrastructure..>INFRASTRUCTURE</top.egon.cola.archetype.source.web.infrastructure..>
                        <top.egon.cola.archetype.source.web.adapter..>ADAPTER</top.egon.cola.archetype.source.web.adapter..>
                        <top.egon.cola.archetype.source.web.starter..>STARTER</top.egon.cola.archetype.source.web.starter..>
                    </packageMappings>
                </configuration>
                <executions>
                    <execution>
                        <id>cola-architecture-check</id>
                        <phase>verify</phase>
                        <goals><goal>check-reactor</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
