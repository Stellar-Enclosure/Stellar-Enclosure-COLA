VITE_OAUTH_JWKS_URI=https://identity.example.test/tenants/42/oauth2/jwks
VITE_PERMISSION_NAMESPACE=default
VITE_PERMISSION_ENVIRONMENT=dev
VITE_BASE_PATH=/
