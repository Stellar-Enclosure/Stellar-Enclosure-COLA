VITE_OAUTH_WEB_ORIGIN=https://admin.example.test
VITE_OAUTH_TENANT_ID=42
VITE_OAUTH_ISSUER=https://identity.example.test/tenants/42
VITE_OAUTH_CLIENT_ID=react-admin-public
VITE_OAUTH_RESOURCE=https://api.example.test/example-admin
VITE_OAUTH_API_BASE_URL=https://api.example.test/example-admin/
